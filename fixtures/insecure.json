{
  "iam": {
    "root_access_keys": 1,
    "root_mfa_enabled": false,
    "unused_access_keys": 3,
    "admin_users": 4,
    "password_policy": {
      "minimum_length": 8
    }
  },
  "s3": [
    {
      "name": "public-data",
      "public_access_block": {
        "BlockPublicAcls": false,
        "IgnorePublicAcls": false,
        "BlockPublicPolicy": false,
        "RestrictPublicBuckets": false
      },
      "encryption": null,
      "versioning": "Suspended"
    }
  ],
  "security_groups": [
    {
      "GroupId": "sg-public-admin",
      "IpPermissions": [
        {
          "IpProtocol": "tcp",
          "FromPort": 22,
          "ToPort": 22,
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ]
        },
        {
          "IpProtocol": "tcp",
          "FromPort": 3389,
          "ToPort": 3389,
          "IpRanges": [
            {
              "CidrIp": "0.0.0.0/0"
            }
          ]
        }
      ]
    }
  ],
  "cloudtrail": [
    {
      "Name": "legacy-trail",
      "IsLogging": false,
      "LogFileValidationEnabled": false,
      "MultiRegionTrail": false
    }
  ]
}
